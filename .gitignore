# 临时检查/调试脚本
_*.py
# 但 Python 包标识与技能目录内脚本必须跟踪（_*.py 会误伤 __init__.py / _bootstrap.py）
!__init__.py
!.trae/skills/**/*.py

# Python 缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# 临时数据文件
_*.txt
_*.json
_*.png
_*.wav
_*.jpg
_*.csv
_*.log
_*.jsonl

# 批量任务工作目录（含 _work 本体及各剧命名变体）
_work*/
_work/

# 运行产物
*.wav
*.mp3
*.mp4
analyze_result.txt
run_result.txt
jianying_coords.json
audio_peak_results.json

# 虚拟环境
venv/
.env

# API 密钥配置（智谱等）
pipeline/vc_config.json

# IDE
.vscode/
.idea/
# Trae 技能入库（仓库核心交付物）；仅忽略本机规划文档与嵌套上游仓库备份
.trae/documents/
.trae/skills/jianying-editor/upstream.git.bak/
.trae/skills/gemini-web-quicker-skill/upstream.git.bak/
# 技能目录内的示例素材不受全局媒体忽略约束
!.trae/skills/**/*.mp3
!.trae/skills/**/*.mp4
!.trae/skills/**/*.wav
_work/

# 系统文件
.DS_Store
Thumbs.db

# 打包文件
*.zip
*.exe

# 剪映本地资源 (体积大，由 sync_jy_assets 自动同步；仅根目录，技能内 assets 正常入库)
/assets/
/covers/
