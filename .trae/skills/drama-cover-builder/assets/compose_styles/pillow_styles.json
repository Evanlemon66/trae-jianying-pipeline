{
  "_comment": "Pillow 封面合成样式参数。改这里调视觉，不用改 Python 代码。",
  "canvas": {
    "vertical":   { "width": 1080, "height": 1920 },
    "horizontal": { "width": 2848, "height": 1600 }
  },
  "title_safe_area": {
    "vertical":   { "top_ratio": 0.72, "bottom_ratio": 0.08, "side_margin_ratio": 0.09 },
    "horizontal": { "top_ratio": 0.78, "bottom_ratio": 0.05, "side_margin_ratio": 0.08 }
  },
  "styles": {
    "classic_red_stroke": {
      "desc": "8px 红描边 + 白字 + 底部黑蒙版，抖音主流万能",
      "stroke_color": "#D90404",
      "stroke_width": 8,
      "text_color": "#FFFFFF",
      "font_weight": "bold",
      "mask": { "type": "bottom", "color": "#000000", "opacity": 0.55, "gradient": true }
    },
    "shadow_outline": {
      "desc": "多层偏移阴影 + 暖白大字 + 深蒙版，年代剧/虐恋",
      "stroke_color": "#1A1A1A",
      "stroke_width": 4,
      "text_color": "#FFF8E7",
      "shadow_offsets": [[4,4],[6,6],[8,8]],
      "shadow_color": "#000000",
      "mask": { "type": "bottom", "color": "#000000", "opacity": 0.60, "gradient": true }
    },
    "neon_glow": {
      "desc": "粉色光晕描边 + 白字 + 浅蒙版，都市/甜宠",
      "stroke_color": "#FF4FA3",
      "stroke_width": 10,
      "glow_color": "#FF4FA3",
      "glow_radius": 20,
      "text_color": "#FFFFFF",
      "mask": { "type": "none" }
    },
    "bottom_tape": {
      "desc": "底部红布条 + 黑描边白字，爽文/逆袭",
      "stroke_color": "#000000",
      "stroke_width": 4,
      "text_color": "#FFFFFF",
      "tape": { "color": "#D90404", "height_ratio": 0.12, "padding_ratio": 0.03 }
    }
  }
}
